{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "dev",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "backend",
        "run",
        "uvicorn",
        "app.asgi:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "backend-live",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SCENEFORK_ADAPTERS=live",
        "SPEND_CAP_USD=1",
        "uv",
        "--directory",
        "backend",
        "run",
        "uvicorn",
        "app.asgi:app",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
