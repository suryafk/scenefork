{
  "description": "Voice presets (design: Intent routing). Matched locally on interim transcripts in under 5 ms; no model call. A pattern hit is confidence 1. Keywords (0.6 for one hit, 0.8 for two, 1 for three) give the closest preset for the codegen failure rule (applied when confidence >= 0.6). Entity fields use `entity:*`: the pointed-at or named entity when the command has one, else every dynamic body. `group: gravity` presets get one-click buttons. `float` (zero gravity) also nudges every dynamic body: random upward and sideways speed in on-screen pixels per second (so it looks the same at any scale) and spin in rad/s, so the scene drifts off its floors.",
  "presets": [
    {
      "id": "zero_gravity",
      "name": "Zero gravity",
      "patterns": [
        "\\b(zero|no) gravity\\b",
        "\\bweightless(ness)?\\b",
        "\\bturn off (the )?gravity\\b",
        "\\bzero[ -]?g\\b",
        "\\b(everything|all|scene|world|it all) (float|floats|floating)\\b",
        "\\bfloat (everything|away)\\b",
        "\\bin (outer )?space\\b"
      ],
      "keywords": [
        "zero",
        "weightless",
        "float",
        "space"
      ],
      "writes": [
        {
          "field": "world.gravity",
          "value": [
            0,
            0
          ]
        }
      ],
      "group": "gravity",
      "float": {
        "up_pxps": [
          30,
          80
        ],
        "side_pxps": 40,
        "spin_radps": 0.6
      }
    },
    {
      "id": "moon_gravity",
      "name": "Moon",
