    "source": "let start = null;\nconst target = 'truck';\nreturn {\n  onGrab(id) {\n    if (id !== target) return;\n    const e = ctx.entity(id);\n    start = { x: e.x, y: e.y };\n  },\n  onRelease(id) {\n    if (id !== target || start == null) return;\n    const e = ctx.entity(id);\n    const k = 12 * e.mass;\n    ctx.applyImpulse(id, (start.x - e.x) * k, (start.y - e.y) * k);\n    start = null;\n  },\n};",
